{
  "manifest_version": 3,
  "name": "PADS Download Handoff",
  "version": "0.1.0",
  "description": "Send browser downloads to the PADS download manager instead of the browser's own downloader.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "notifications",
    "contextMenus"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "PADS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/pads-16.png",
      "32": "icons/pads-32.png",
      "48": "icons/pads-48.png",
      "128": "icons/pads-128.png"
    }
  },
  "icons": {
    "16": "icons/pads-16.png",
    "32": "icons/pads-32.png",
    "48": "icons/pads-48.png",
    "128": "icons/pads-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pads@localhost",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": [
      "host.js",
      "background.js"
    ]
  }
}
